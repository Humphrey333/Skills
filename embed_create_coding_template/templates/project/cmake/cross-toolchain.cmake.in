# Cross toolchain for @TARGET_ARCH@. Use with:
#   cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=cmake/@TARGET_ARCH@-cross.cmake
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR @TARGET_ARCH@)

set(CMAKE_SYSROOT "@SYSROOT@")
set(CMAKE_C_COMPILER   @COMPILER_PREFIX@-gcc)
set(CMAKE_CXX_COMPILER @COMPILER_PREFIX@-g++)

# Search headers/libs/packages only in the sysroot; run build tools from the host.
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# pkg-config must resolve against the board sysroot, not the host.
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR}
  "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/lib/@TARGET_ARCH@-linux-gnu/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
